-    return requestDiagnostics(
-      filePath,
-      [
-        requestDiagnosticReport(filePath),
-        ...state.documentIdentifiers.map((identifier) => requestDiagnosticReport(filePath, identifier)),
-      ],
-      (results) => hasCurrentFileDiagnostics(filePath, results),
